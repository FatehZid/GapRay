{
  "manifest_version": 3,
  "name": "GapRay",
  "version": "0.1.2",
  "description": "X-ray any webpage's spacing and sizes: padding, gaps, radius and type. 100% local.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GapRay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-gapray": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Turn GapRay on or off"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "motion.css"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
